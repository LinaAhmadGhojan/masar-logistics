# Base URL of the Masar API (no trailing slash).
# For the APK this must be a public HTTPS address (or your PC's LAN IP while testing) - not localhost.
NEXT_PUBLIC_API_URL=http://localhost:8020
# 1 = run entirely in the browser on built-in sample data (no API needed). Used for the portfolio build.
NEXT_PUBLIC_LOCAL=0
# Sub-folder the site is served from, e.g. /masar-logistics (portfolio hosting). Empty at the root / inside the APK.
NEXT_PUBLIC_BASE_PATH=
