# The API reads real environment variables (it does not load this file by itself).
DATABASE_URL=sqlite:///./masar.db
# postgresql+psycopg://user:pass@host/db

# REQUIRED in production
JWT_SECRET=change-me
ADMIN_LOGIN=admin@masar.local
ADMIN_PASSWORD=admin1234

CORS_ORIGINS=http://localhost:3020,http://localhost:3000,https://localhost,capacitor://localhost,http://localhost
TZ_OFFSET=3
UPLOAD_DIR=./uploads
# Set to 0 to never call the public OSRM server (offline / tests)
OSRM_ENABLED=1
